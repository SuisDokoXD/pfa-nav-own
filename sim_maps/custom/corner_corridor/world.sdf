<?xml version="1.0"?>
<sdf version="1.7">
  <world name="default">
    <physics name="default_physics" type="ode">
      <max_step_size>0.01</max_step_size>
      <real_time_update_rate>100</real_time_update_rate>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="libignition-gazebo-physics-system.so" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="libignition-gazebo-scene-broadcaster-system.so" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="libignition-gazebo-user-commands-system.so" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="libignition-gazebo-sensors-system.so" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="libignition-gazebo-imu-system.so" name="ignition::gazebo::systems::Imu"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.4 0.2 -1</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material><ambient>0.72 0.72 0.72 1</ambient><diffuse>0.72 0.72 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- L-shaped enclosed corridor. Clear width is 2.1 m; wall height is 2.5 m. -->
    <model name="south_wall"><static>true</static><pose>-3.975 -1.15 1.25 0 0 0</pose><link name="wall"><collision name="collision"><geometry><box><size>10.45 0.2 2.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>10.45 0.2 2.5</size></box></geometry><material><ambient>0.45 0.48 0.5 1</ambient><diffuse>0.45 0.48 0.5 1</diffuse></material></visual></link></model>
    <model name="east_wall"><static>true</static><pose>1.15 3.975 1.25 0 0 0</pose><link name="wall"><collision name="collision"><geometry><box><size>0.2 10.45 2.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.2 10.45 2.5</size></box></geometry><material><ambient>0.45 0.48 0.5 1</ambient><diffuse>0.45 0.48 0.5 1</diffuse></material></visual></link></model>
    <model name="north_cap"><static>true</static><pose>-0.05 9.1 1.25 0 0 0</pose><link name="wall"><collision name="collision"><geometry><box><size>2.4 0.2 2.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>2.4 0.2 2.5</size></box></geometry><material><ambient>0.45 0.48 0.5 1</ambient><diffuse>0.45 0.48 0.5 1</diffuse></material></visual></link></model>
    <model name="west_inner_wall"><static>true</static><pose>-1.15 5.125 1.25 0 0 0</pose><link name="wall"><collision name="collision"><geometry><box><size>0.2 8.15 2.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.2 8.15 2.5</size></box></geometry><material><ambient>0.45 0.48 0.5 1</ambient><diffuse>0.45 0.48 0.5 1</diffuse></material></visual></link></model>
    <model name="west_corridor_wall"><static>true</static><pose>-5.125 1.15 1.25 0 0 0</pose><link name="wall"><collision name="collision"><geometry><box><size>8.15 0.2 2.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>8.15 0.2 2.5</size></box></geometry><material><ambient>0.45 0.48 0.5 1</ambient><diffuse>0.45 0.48 0.5 1</diffuse></material></visual></link></model>
    <model name="west_cap"><static>true</static><pose>-9.1 0 1.25 0 0 0</pose><link name="wall"><collision name="collision"><geometry><box><size>0.2 2.5 2.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.2 2.5 2.5</size></box></geometry><material><ambient>0.45 0.48 0.5 1</ambient><diffuse>0.45 0.48 0.5 1</diffuse></material></visual></link></model>
  </world>
</sdf>
